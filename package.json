{
  "name": "communes-france-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3010 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3011 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "test:communes": "node scripts/verify-communes.mjs",
    "format": "prettier --write src tests scripts vite.config.ts index.html README.md",
    "test:interactions": "node scripts/verify-interactions.mjs",
    "test:resilience": "node scripts/verify-resilience.mjs",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "earcut": "3.0.2",
    "geotiff": "2.1.3",
    "maplibre-gl": "6.10.0",
    "polygon-clipping": "0.15.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/earcut": "3.0.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.0.0",
    "@types/three": "0.185.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
